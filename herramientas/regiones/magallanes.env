# Región de prueba: Magallanes y de la Antártica Chilena (parte continental e insular).
# El rectángulo incluye también la franja argentina vecina (Río Gallegos, El Calafate,
# Río Grande, Ushuaia) para que el mapa no quede en blanco en la frontera y las rutas
# que cruzan a Argentina (p. ej. Tierra del Fuego) se puedan calcular.
REGION_ID=magallanes
REGION_NOMBRE="Región de Magallanes"
# min_lon,min_lat,max_lon,max_lat
BBOX="-76.0,-56.2,-65.0,-48.5"
# Extractos OSM de origen (Geofabrik); se recortan al BBOX y se unen.
OSM_FUENTES="https://download.geofabrik.de/south-america/chile-latest.osm.pbf https://download.geofabrik.de/south-america/argentina-latest.osm.pbf"
# Modelo de elevación para curvas de nivel y relieve (Copernicus GLO-30, 30 m).
DEM_FUENTE="copernicus-glo30"
CURVAS_INTERVALO_M=20
